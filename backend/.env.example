# ==============================================================================
# VOID Backend Environment Configuration (Template)
# ==============================================================================
# Copy this file to '.env' for local development:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
#
# CRITICAL SECURITY NOTICE:
# Never commit '.env' or real production secrets to Git.
# Actual secrets must be configured directly within your cloud hosting dashboard
# (e.g., Render, Railway, Vercel) or stored in an encrypted secrets vault.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
# Server port Express listens on
PORT=5000

# Environment mode: 'development', 'production', or 'test'
# Setting this to 'production' enforces:
# - Strict MONGODB_URI requirement (disallows localhost fallback)
# - Strict JWT_SECRET requirement
# - Default trust proxy hop configuration for cloud reverse proxies
# - Secure HTTPS session cookies (unless overridden)
# - Sanitized 500 error responses (masks internal stack traces from clients)
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Database Connection (MongoDB)
# ------------------------------------------------------------------------------
# In development/test, omitting this defaults to: mongodb://127.0.0.1:27017/void_db
# In production, MONGODB_URI is strictly required. The server will fail early
# on startup if MONGODB_URI is missing or empty, preventing silent localhost errors.
# Example Atlas connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/void_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/void_db

# ------------------------------------------------------------------------------
# 3. Reverse Proxy & Network Topology
# ------------------------------------------------------------------------------
# Configures Express 'trust proxy' to correctly identify client IPs behind
# reverse proxies, load balancers, or CDNs (Render, Railway, Heroku, AWS ALB, Nginx).
#
# Values:
# - '1' (Default in production): Trusts the immediate front-facing reverse proxy (1 hop).
#   Protects rate limiters from grouping all users under one proxy IP, and enables
#   Express to correctly identify HTTPS connections via 'X-Forwarded-Proto'.
# - 'false' (Default in development): Direct connection, no proxy trusted.
# - '2' or higher: For multi-tiered proxies (e.g. Cloudflare -> Render -> Node).
# DO NOT set this to broad 'true' without reason, as trusting arbitrary client
# headers permits IP spoofing.
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 4. Frontend Origins & Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Explicit allowlist of frontend URLs permitted to make credentialed requests
# and access API data. Protects against Cross-Site Request Forgery (CSRF).
#
# Multi-Origin Support:
# Provide a comma-separated list of origins.
# Whitespace and trailing slashes are automatically trimmed and normalized.
#
# Local development:
FRONTEND_URL=http://localhost:5173
#
# Production example (apex and www subdomains):
# FRONTEND_URL=https://void.atelier,https://www.void.atelier
#
# Staging example:
# FRONTEND_URL=https://void.atelier,https://void-staging.vercel.app

# ------------------------------------------------------------------------------
# 5. Session Authentication (JWT & HttpOnly Cookies)
# ------------------------------------------------------------------------------
# Secret key used to sign and verify HMAC-SHA256 JWT tokens.
# In production, generate a cryptographically strong 64-character random string:
#   Terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_32_characters_long_for_dev

# JWT expiration window (e.g. '7d', '24h', '1h')
JWT_EXPIRES_IN=7d

# SameSite cookie behavior: 'lax', 'strict', or 'none'
# - 'lax' (Default & Recommended): Optimal balance for modern web security.
#   Provides strong CSRF protection while sending the session cookie on top-level
#   GET navigations (e.g. clicking a link in an email). Ideal when frontend and
#   backend share the same root domain (e.g. void.atelier & api.void.atelier).
# - 'strict': Only sends cookies on requests originating from the exact same site.
# - 'none': Required ONLY if frontend and backend are hosted on completely separate
#   eTLD+1 domains (e.g. void.vercel.app and void-api.onrender.com).
#   NOTE: 'none' requires COOKIE_SECURE=true. Genuinely cross-site cookies can be
#   blocked by modern browser privacy controls (Safari ITP, Brave, Chrome).
#   A shared custom root domain or a same-origin reverse proxy is far more reliable.
COOKIE_SAME_SITE=lax

# Secure cookie flag (HTTPS enforcement):
# In development: defaults to 'false' (enables authentication over local HTTP).
# In production: defaults to 'true' (blocks cookies over unencrypted HTTP).
# Setting COOKIE_SAME_SITE=none will always force Secure=true as required by browsers.
COOKIE_SECURE=false

# Optional root cookie domain:
# Leave unset for standard host-only cookies (recommended for security).
# If your frontend is 'void.atelier' and backend is 'api.void.atelier', setting:
# COOKIE_DOMAIN=.void.atelier
# allows both subdomains to share the session cookie.
# COOKIE_DOMAIN=.void.atelier
